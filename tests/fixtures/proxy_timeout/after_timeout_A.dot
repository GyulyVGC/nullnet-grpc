digraph G {
	bgcolor=grey10;
	node [color=white, fontcolor=white];
	edge [color=white, fontcolor=white, fontsize=9, labelangle=180, labeldistance=0.8];

	"A" [style=solid, color=green];

	"B" [style=solid, color=green];
	"10.0.0.1 (via 5.5.5.5)" -> "B" [label="VLAN 105 [0ms]"];

	"C" [style=dashed, color=green];

	"D" [style=dashed, color=green];
	"B" -> "D" [label="VLAN 104 [0ms]"];
}
